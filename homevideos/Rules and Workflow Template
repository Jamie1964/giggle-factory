    <meta property="og:description" content="Detailed description of the video.">
    <meta property="og:type" content="video.other">
    <meta property="og:url" content="https://giggle-factory.com/homevideos/YOUTUBE_ID.html">

    <!-- Schema.org VideoObject Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "VideoObject",
      "name": "Video Title",
      "description": "Detailed description of the video.",
      "thumbnailUrl": "https://img.youtube.com/vi/YOUTUBE_ID/hqdefault.jpg",
      "uploadDate": "YYYY-MM-DD",
      "duration": "PT00M00S",
      "embedUrl": "https://www.youtube.com/embed/YOUTUBE_ID",
      "author": {
